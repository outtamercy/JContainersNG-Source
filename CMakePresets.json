{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_HOST_TRIPLET": "x64-windows-skse",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-skse"
      }
    },
    {
      "name": "release-msvc",
      "inherits": [
        "base"
      ],
      "displayName": "Release (SE/AE)",
      "description": "Optimized release build for Skyrim SE/AE/GOG.",
      "cacheVariables": {
        "BUILD_VR": "OFF"
      }
    },
    {
      "name": "release-msvc-vr",
      "inherits": [
        "base"
      ],
      "displayName": "Release (VR)",
      "description": "Optimized release build for Skyrim VR.",
      "cacheVariables": {
        "BUILD_VR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release-msvc",
      "displayName": "Release (MSVC)",
      "configurePreset": "release-msvc",
      "configuration": "Release"
    },
    {
      "name": "release-msvc-vr",
      "displayName": "Release VR (MSVC)",
      "configurePreset": "release-msvc-vr",
      "configuration": "Release"
    }
  ]
}
